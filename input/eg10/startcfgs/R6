hostname R6
interface Loopback0
 description loopback
 ip address 2.127.0.6 255.255.255.255
 no shutdown
interface GigabitEthernet0/0
 description R6_R5
 ip address 2.5.0.2 255.255.255.252
 ip ospf cost 30
 no shutdown
interface GigabitEthernet0/1
 description R6_RR4
 ip address 2.4.2.2 255.255.255.252
 ip ospf cost 120
 no shutdown
router ospf 1
 network 2.0.0.0 0.255.255.255 area 0
router bgp 2
 neighbor 2.127.0.4 remote-as 2
 neighbor 2.127.0.4 update-source loopback0
 neighbor 2.127.0.4 aigp
! network 2.127.0.6 mask 255.255.255.255 route-map SET_AIGP
 address-family ipv4
  bgp additional-paths receive
route-map SET_AIGP permit 10
 set aigp-metric igp-metric
do wr