hostname RR6
interface Loopback0
 description loopback
 ip address 2.127.0.6 255.255.255.255
 no shutdown
interface GigabitEthernet0/0
 description RR6_R3
 ip address 2.3.1.2 255.255.255.252
 ip ospf cost 30
 no shutdown
interface GigabitEthernet0/1
 description RR6_R5
 ip address 2.5.0.2 255.255.255.252
 ip ospf cost 10
 no shutdown
interface GigabitEthernet0/2
 description RR6_R7
 ip address 2.6.2.1 255.255.255.252
 ip ospf cost 10
 no shutdown
interface GigabitEthernet0/3
 description RR6_R8
 ip address 2.6.3.1 255.255.255.252
 ip ospf cost 10
 no shutdown
router ospf 1
 network 2.0.0.0 0.255.255.255 area 0
router bgp 2
 neighbor 2.127.0.3 remote-as 2
 neighbor 2.127.0.3 update-source loopback0
 neighbor 2.127.0.3 aigp
 neighbor 2.127.0.5 remote-as 2
 neighbor 2.127.0.5 update-source loopback0
 neighbor 2.127.0.5 aigp
 neighbor 2.127.0.7 remote-as 2
 neighbor 2.127.0.7 update-source loopback0
 neighbor 2.127.0.7 aigp
 neighbor 2.127.0.8 remote-as 2
 neighbor 2.127.0.8 update-source loopback0
 neighbor 2.127.0.8 aigp
! network 2.127.0.6 mask 255.255.255.255 route-map SET_AIGP
 neighbor 2.127.0.3 route-reflector-client
 neighbor 2.127.0.5 route-reflector-client
 neighbor 2.127.0.7 route-reflector-client
 neighbor 2.127.0.8 route-reflector-client
 address-family ipv4
  bgp additional-paths send receive
  bgp additional-paths select all
  neighbor 2.127.0.3 advertise additional-paths all
  neighbor 2.127.0.5 advertise additional-paths all
  neighbor 2.127.0.7 advertise additional-paths all
  neighbor 2.127.0.8 advertise additional-paths all
route-map SET_AIGP permit 10
 set aigp-metric igp-metric
do wr